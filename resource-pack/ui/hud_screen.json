{
  "namespace": "hud",

  // Indicateur micro Galaxium Vocal (bas droite).
  // Le serveur envoie un titre "gvc:on" / "gvc:talk" / "gvc:mute" / "gvc:off" :
  // il est mémorisé ici et n'est jamais affiché comme un vrai titre.
  "gvc_indicator": {
    "type": "image",
    "size": [ 20, 20 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -6, -6 ],
    "layer": 40,
    "texture": "#texture",
    "controls": [
      {
        "gvc_data": {
          "type": "panel",
          "size": [ 0, 0 ],
          "property_bag": { "#preserved_text": "gvc:off" },
          "bindings": [
            { "binding_name": "#hud_title_text_string" },
            {
              "binding_name": "#hud_title_text_string",
              "binding_name_override": "#preserved_text",
              "binding_condition": "visibility_changed"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - 'gvc:') = #hud_title_text_string))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "gvc_data",
        "source_property_name": "('textures/ui/galaxium_vocal/' + (#preserved_text - 'gvc:'))",
        "target_property_name": "#texture"
      }
    ]
  },

  // Les titres "gvc:..." ne s'affichent jamais à l'écran
  "hud_title_text": {
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - 'gvc:') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [ { "gvc_indicator@hud.gvc_indicator": {} } ]
      }
    ]
  }
}
